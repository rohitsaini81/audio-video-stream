        if test yes = "$supports_anon_versioning"; then
          archive_expsym_cmds_OBJC='echo "{ global:" > $output_objdir/$libname.ver~
            cat $export_symbols | $SED -e "s/\(.*\)/\1;/" >> $output_objdir/$libname.ver~
